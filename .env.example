TG_BOT_TOKEN=
MAX_BOT_TOKEN=

# MAX API (по умолчанию platform-api2.max.ru — актуальный домен в docs MAX)
# MAX_API_URL=https://platform-api2.max.ru

# Optional: override default Redis URL
# REDIS_URL=redis://redis:6379

# Optional: comma-separated Telegram user IDs for alerts
# ADMIN_IDS=123456789,987654321

# MAX webhook — обязателен с 11.05.2026 для нормальной работы.
# При активной подписке long polling (GET /updates) недоступен — это нормально.
# MAX_USE_WEBHOOK=1
# MAX_WEBHOOK_PUBLIC_URL=https://ваш-домен.ru/max/webhook
# MAX_WEBHOOK_LISTEN_HOST=0.0.0.0
# MAX_WEBHOOK_LISTEN_PORT=8080
# Секрет 5–256 символов [a-zA-Z0-9_-] для заголовка X-Max-Bot-Api-Secret.
# Рекомендуется задать — без него любой, кто узнает URL, может слать события.
# WEBHOOK_SECRET=

# Optional: path to connectors config
# CONNECTORS_FILE=./connectors.json
