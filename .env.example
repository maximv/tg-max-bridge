TG_BOT_TOKEN=
MAX_BOT_TOKEN=

# Optional: explicit MAX API URL
# MAX_API_URL=https://platform-api.max.ru

# Optional: override default Redis URL
# REDIS_URL=redis://redis:6379

# Optional: comma-separated Telegram user IDs for alerts
# ADMIN_IDS=123456789,987654321

# Optional: webhook secret for future webhook mode
# WEBHOOK_SECRET=

# Optional: path to connectors config
# CONNECTORS_FILE=./connectors.json
